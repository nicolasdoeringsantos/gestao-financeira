{
  "name": "gestao-financeira-precificacao",
  "version": "1.0.0",
  "description": "Aplicativo web de Gestão Financeira e Precificação para pequenas empresas",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788",
    "dev:full": "npm run build && concurrently -k \"npm:dev\" \"npm:dev:api\"",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "vite": "^8.2.1",
    "wrangler": "^4.124.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true
  }
}
